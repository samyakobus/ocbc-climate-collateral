# Copy to .env. Never commit .env.

# Local development uses the PGlite + PostGIS server: `npm run db:up`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ocbc
# Under docker compose the host is the service name instead:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/ocbc

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ocbc

# Where the PGlite server persists its data directory (local dev only).
PGLITE_DATA_DIR=./data/pglite
PGLITE_PORT=5432

# Day 4 only. Every LLM path has a tested deterministic fallback, so the app runs without this.
ANTHROPIC_API_KEY=

# Per-property satellite thumbnail, the one live call the spec requires (plan 4.9).
GOOGLE_MAPS_STATIC_KEY=

# iron-session cookie secret, 32+ characters.
AUTH_SECRET=

# The three outbound hosts, all optional. Leave them unset in normal use: the
# defaults are the real services. The offline rehearsal points them at a dead port
# so the SERVER is genuinely offline, which a browser-level block cannot achieve:
#   FEED_EONET_BASE=http://127.0.0.1:9 FEED_GIBS_BASE=http://127.0.0.1:9 #     THUMB_BASE=http://127.0.0.1:9 npx playwright test
# They are read at request time, so no rebuild is needed to change one.
FEED_EONET_BASE=
FEED_GIBS_BASE=
THUMB_BASE=

# Protomaps daily planet build, read by scripts/fetch-basemap.ts (plan 4.7).
# Leave blank: the builds are retained about a week, so the script resolves the newest one
# itself. Set it only to pin a specific build, e.g. https://build.protomaps.com/20260906.pmtiles
PLANET_URL=
